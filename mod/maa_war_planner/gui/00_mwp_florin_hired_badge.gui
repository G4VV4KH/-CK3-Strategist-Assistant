  text_single = { name = "mwp_priority_number" datacontext = "[GetPlayer.MakeScope.GetVariable(Select_CString(And(GetPlayer.IsValid,And(GetPlayer.MakeScope.GetVariable('mwp_scores_owner').IsSet,And(ObjectsEqual(GetPlayer,GetPlayer.MakeScope.GetVariable('mwp_scores_owner').GetCharacter),And(GetPlayer.MakeScope.GetVariable('mwp_scores_generation').IsSet,EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_scores_generation').GetValueWithDefault('(CFixedPoint)-1'),GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-2')))))),Concatenate('mwp_priority_',IntToString(FixedPointToInt(Regiment.MakeScope.ScriptValue('mwp_florin_hired_type_id')))),'mwp_rank_unavailable'))]"
