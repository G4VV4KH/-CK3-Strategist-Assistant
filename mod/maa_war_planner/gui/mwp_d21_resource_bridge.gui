window = { name = mwp_d21_resource_bridge size = { 1 1 } alwaystransparent = yes
 visible = "[And(GetPlayer.IsValid,Not(GameIsMultiplayer))]"
 datacontext = "[AccessTopBar]"
 state = { name = mwp_d21r_session_clear trigger_on_create = yes alpha = 1 duration = 0
  on_finish = "[GetVariableSystem.Clear('mwp_d21r_session_player')]" }
widget = { name = mwp_d21r_session_worker size = { 1 1 } alwaystransparent = yes
 state = { name = mwp_d21r_session_poll trigger_on_create = yes alpha = 1 duration = 0.1
  on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(GetPlayer.IsValid,Not(GameIsMultiplayer)),Not(And(GetVariableSystem.HasValue('mwp_d21r_session_player',UIntToString(GetPlayer.GetID)),And(GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').IsSet,ObjectsEqual(GetPlayer,GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').GetCharacter))))),'mwp_d21r_session_commit','mwp_d21r_session_idle'))]" }
