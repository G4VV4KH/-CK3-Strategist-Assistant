  on_start = "[GetVariableSystem.Set('mwp_d21r_session_player',UIntToString(GetPlayer.GetID))]"
 }
 state = { name = mwp_d21r_session_idle alpha = 1 duration = 0 next = mwp_d21r_session_poll }
}
