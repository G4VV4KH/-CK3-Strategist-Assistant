   on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetPlayer.IsValid,And(Not(GameIsMultiplayer),And(Not(Or(GetPlayer.GetGovernment.IsType('feudal_government'),GetPlayer.GetGovernment.IsType('clan_government'))),And(Or(IsGameViewOpen('military'),Or(GetPlayer.MakeScope.GetVariable('mwp_auto_recruit_enabled').IsSet,Or(GetPlayer.MakeScope.GetVariable('mwp_batch_active').IsSet,GetPlayer.MakeScope.GetVariable('mwp_d21p_pending').IsSet))),Not(And(And(GetVariableSystem.HasValue('mwp_d21r_session_player',UIntToString(GetPlayer.GetID)),And(GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').IsSet,ObjectsEqual(GetPlayer,GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').GetCharacter))),GetPlayer.MakeScope.GetVariable('mwp_florin_wallet_awake').IsSet)))))),Select_CString(And(GetVariableSystem.HasValue('mwp_d21r_session_player',UIntToString(GetPlayer.GetID)),And(GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').IsSet,ObjectsEqual(GetPlayer,GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').GetCharacter))),'mwp_rp_wallet_wake','mwp_rp_wallet_reset'),'mwp_rp_wallet_idle'))]" }
  state = { name = mwp_rp_wallet_reset alpha = 1 duration = 0.18 next = mwp_rp_wallet_check
   on_start = "[GetScriptedGui('mwp_d21r_reset').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_d21r_input_owner',GetPlayer.MakeScope).End)]"
   on_start = "[GetVariableSystem.Set('mwp_d21r_session_player',UIntToString(GetPlayer.GetID))]" }
  state = { name = mwp_rp_wallet_wake alpha = 1 duration = 0.18 next = mwp_rp_wallet_check
   on_start = "[GetScriptedGui('mwp_florin_wallet_wake').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_d21r_input_owner',GetPlayer.MakeScope).End)]" }
  state = { name = mwp_rp_wallet_idle alpha = 1 duration = 0.18 next = mwp_rp_wallet_check }
 } }
}
