  on_finish = "[GetVariableSystem.Clear('mwp_d21r_session_player')]" }

widget = { size = { 1 1 } alwaystransparent = yes
 datamodel = "[DataModelFirst(GetPlayer.MakeScope.GetList('mwp_id_finance_rows'),Select_int32(And(GetPlayer.IsValid,And(Not(GameIsMultiplayer),And(Not(Or(GetPlayer.GetGovernment.IsType('feudal_government'),GetPlayer.GetGovernment.IsType('clan_government'))),And(Or(IsGameViewOpen('military'),Or(GetPlayer.MakeScope.GetVariable('mwp_auto_recruit_enabled').IsSet,Or(GetPlayer.MakeScope.GetVariable('mwp_batch_active').IsSet,GetPlayer.MakeScope.GetVariable('mwp_d21p_pending').IsSet))),Not(And(And(GetVariableSystem.HasValue('mwp_d21r_session_player',UIntToString(GetPlayer.GetID)),And(GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').IsSet,ObjectsEqual(GetPlayer,GetPlayer.MakeScope.GetVariable('mwp_d21r_owner').GetCharacter))),GetPlayer.MakeScope.GetVariable('mwp_florin_wallet_awake').IsSet)))))),'(int32)1','(int32)0'))]"
