 blockoverride "radio" { size = { 22 22 } frame = "[BoolTo1And2(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_auto_budget_mode').GetValueWithDefault('(CFixedPoint)2'),'(CFixedPoint)5'))]" }
 blockoverride "text" { text = "mwp_budget_half_label" fontsize = 16 max_width = 99 }
 }
 }
 hbox = { spacing = 5 size = { 390 28 }
 button_radio_label = { name = "mwp_budget_maa" size = { 190 28 }
 enabled = "[GetScriptedGui('mwp_auto_budget_maa').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('mwp_auto_budget_maa').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
