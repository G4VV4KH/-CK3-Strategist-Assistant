type mwp_dev10_controls = vbox {
 name = "mwp_dev10_controls" layoutpolicy_horizontal = expanding spacing = 2
button_checkbox_label = { name = "mwp_auto_recruit_checkbox" size = { 390 28 }
 enabled = "[And(Not(GameIsMultiplayer),GetScriptedGui('mwp_toggle_auto').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_script_input_owner',GetPlayer.MakeScope).AddScope('mwp_script_input_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)0'))).AddScope('mwp_script_input_singleplayer',MakeScopeBool(Not(GameIsMultiplayer))).AddScope('mwp_input_current_balance',MakeScopeValue(GetPlayer.GetBalance)).AddScope('mwp_input_native_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_native_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_fallback_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_fallback_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_cost_max_maa',MakeScopeValue(IntToFixedPoint(GetPlayerArmyComposition.GetMaxNumberOfMAA))).AddScope('mwp_input_cost_panel_open',MakeScopeBool(IsGameViewOpen('military'))).End))]" onclick = "[GetScriptedGui('mwp_toggle_auto').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_script_input_owner',GetPlayer.MakeScope).AddScope('mwp_script_input_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)0'))).AddScope('mwp_script_input_singleplayer',MakeScopeBool(Not(GameIsMultiplayer))).AddScope('mwp_input_current_balance',MakeScopeValue(GetPlayer.GetBalance)).AddScope('mwp_input_native_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_native_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_fallback_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_fallback_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_cost_max_maa',MakeScopeValue(IntToFixedPoint(GetPlayerArmyComposition.GetMaxNumberOfMAA))).AddScope('mwp_input_cost_panel_open',MakeScopeBool(IsGameViewOpen('military'))).End)]"
 tooltip = "mwp_auto_recruit_tooltip"
 blockoverride "checkbox" { checked = "[GetPlayer.MakeScope.GetVariable('mwp_auto_recruit_enabled').IsSet]" }
 blockoverride "text" { text = "mwp_auto_recruit_label" max_width = 355 fontsize = 16 }
}
button_checkbox_label = { name = "mwp_reorganization_checkbox" size = { 390 28 }
 enabled = "[And(Not(GameIsMultiplayer),GetScriptedGui('mwp_toggle_reorganization').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_script_input_owner',GetPlayer.MakeScope).AddScope('mwp_script_input_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)0'))).AddScope('mwp_script_input_singleplayer',MakeScopeBool(Not(GameIsMultiplayer))).AddScope('mwp_input_current_balance',MakeScopeValue(GetPlayer.GetBalance)).AddScope('mwp_input_native_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_native_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_fallback_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_fallback_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_cost_max_maa',MakeScopeValue(IntToFixedPoint(GetPlayerArmyComposition.GetMaxNumberOfMAA))).AddScope('mwp_input_cost_panel_open',MakeScopeBool(IsGameViewOpen('military'))).End))]" onclick = "[GetScriptedGui('mwp_toggle_reorganization').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_script_input_owner',GetPlayer.MakeScope).AddScope('mwp_script_input_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)0'))).AddScope('mwp_script_input_singleplayer',MakeScopeBool(Not(GameIsMultiplayer))).AddScope('mwp_input_current_balance',MakeScopeValue(GetPlayer.GetBalance)).AddScope('mwp_input_native_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_native_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_fallback_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_fallback_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_cost_max_maa',MakeScopeValue(IntToFixedPoint(GetPlayerArmyComposition.GetMaxNumberOfMAA))).AddScope('mwp_input_cost_panel_open',MakeScopeBool(IsGameViewOpen('military'))).End)]"
 tooltip = "mwp_dev10_reorganization_tooltip"
 blockoverride "checkbox" { checked = "[GetPlayer.MakeScope.GetVariable('mwp_reorganization_enabled').IsSet]" }
 blockoverride "text" { text = "mwp_dev10_reorganization_label" max_width = 355 fontsize = 16 }
}
text_single = { name = "mwp_budget_caption" text = "mwp_budget_label"
