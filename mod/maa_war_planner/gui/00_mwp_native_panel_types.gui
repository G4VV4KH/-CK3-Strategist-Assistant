 }
}
 hbox = { spacing = 8 layoutpolicy_horizontal = expanding
  button_tertiary = { name = "mwp_refresh_analysis" text = "mwp_refresh_label" size = { 135 28 }
   enabled = "[GetScriptedGui('mwp_request_analysis').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   onclick = "[GetScriptedGui('mwp_request_analysis').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
   tooltip = "mwp_refresh_tooltip"
  }
  text_single = { name = "mwp_auto_status" text = "[GetPlayer.Custom('mwp_auto_status_text')]" max_width = 245 fontsize = 14
   tooltip = "mwp_auto_recruit_tooltip" visible = "[Not(GameIsMultiplayer)]" }
  text_single = { text = "mwp_auto_status_multiplayer" max_width = 245 fontsize = 14 visible = "[GameIsMultiplayer]" }
 }
 divider_light = { layoutpolicy_horizontal = expanding }
