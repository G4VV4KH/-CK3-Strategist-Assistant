 blockoverride "radio" { size = { 22 22 } frame = "[BoolTo1And2(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_auto_budget_mode').GetValueWithDefault('(CFixedPoint)2'),'(CFixedPoint)3'))]" }
 blockoverride "text" { text = "mwp_budget_unlimited_label" fontsize = 16 max_width = 164 }
