type mwp_dev15_maintenance_metrics = vbox {
 name = "mwp_dev15_maintenance_metrics"
 visible = "[And(GetPlayer.IsValid, ObjectsEqual(MilitaryView.GetCharacter, GetPlayer))]"
 layoutpolicy_horizontal = expanding
 hbox = { name = "mwp_d15_raised_army" layoutpolicy_horizontal = expanding spacing = 5
  text_single = { text = "mwp_d15_raised_army_label" fontsize = 14 max_width = 280 tooltip = "mwp_d15_raised_army_tooltip" }
  expand = {}
  text_single = { name = "mwp_cost_cache_army_approx" fontsize = 14 max_width = 100
   visible = "[And(GetScriptedGui('mwp_d21_gold_forecast_supported').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End),GetScriptedGui('mwp_cost_cache_fallback_display').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
   text = "mwp_cost_cache_army_approx_text" tooltip = "mwp_d15_raised_army_tooltip"
  }
  text_single = { name = "mwp_d15_raised_army_pending" fontsize = 14 max_width = 100
   visible = "[Not(And(GetScriptedGui('mwp_d21_gold_forecast_supported').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End),GetScriptedGui('mwp_cost_cache_fallback_display').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
   text = "mwp_d15_metrics_pending" tooltip = "[SelectLocalization(GetScriptedGui('mwp_d21_gold_forecast_supported').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End),'mwp_d15_metrics_pending_tooltip','mwp_d15_raised_army_tooltip')]"
  }
 }
}
# MWP DEV19 END maintenance_metric_type
}
