        on_start = "[GetScriptedGui('mwp_native_live_regiment').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_candidate_owner',GetPlayer.MakeScope).AddScope('mwp_candidate_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_live_actor',GetPlayer.MakeScope.Var('mwp_live_character').GetCharacter.MakeScope).AddScope('mwp_live_epoch',MakeScopeValue(GetPlayer.MakeScope.Var('mwp_live_epoch').GetValue)).AddScope('mwp_live_regiment',Regiment.MakeScope).AddScope('mwp_live_damage',MakeScopeValue(MenAtArmsType.GetStat(Character.Self,Province.Self,Title.Self,'damage'))).AddScope('mwp_live_toughness',MakeScopeValue(MenAtArmsType.GetStat(Character.Self,Province.Self,Title.Self,'toughness'))).AddScope('mwp_live_pursuit',MakeScopeValue(MenAtArmsType.GetStat(Character.Self,Province.Self,Title.Self,'pursuit'))).AddScope('mwp_live_screen',MakeScopeValue(MenAtArmsType.GetStat(Character.Self,Province.Self,Title.Self,'screen'))).AddScope('mwp_live_siege',MakeScopeValue(MenAtArmsType.GetStat(Character.Self,Province.Self,Title.Self,'siege_value'))).AddScope('mwp_live_stack',MakeScopeValue(IntToFixedPoint(MenAtArmsType.GetStackSize))).End)]"
    }
state = { name = mwp_live_regiment_observe_idle alpha = 1
 on_start = "[PdxGuiWidget.TriggerAnimation('mwp_live_regiment_observe_poll')]" }
} } }
widget = { name = mwp_live_character_worker size = { 1 1 }
state = { name = mwp_live_character_observe_poll trigger_on_create = yes alpha = 1 duration = 0.01
 on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(And(GetPlayer.IsValid,And(GetPlayer.MakeScope.GetVariable('mwp_scoring_active').IsSet,And(ObjectsEqual(GetPlayer,GetPlayer.MakeScope.GetVariable('mwp_scoring_owner').GetCharacter),EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_scoring_generation').GetValueWithDefault('(CFixedPoint)-2'),GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-1'))))),And(GetPlayer.MakeScope.GetVariable('mwp_live_collecting').IsSet,EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_live_stage').GetValueWithDefault('(CFixedPoint)0'),'(CFixedPoint)1'))),And(GetPlayer.MakeScope.GetVariable('mwp_live_character').GetCharacter.IsValid,Not(GetPlayer.MakeScope.GetVariable('mwp_live_character_seen').IsSet))),'mwp_live_character_observe_do','mwp_live_character_observe_idle'))]" }
state = { name = mwp_live_character_observe_do alpha = 1
