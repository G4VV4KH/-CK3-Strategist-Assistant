}

# A dead list item cannot emit a Regiment receipt. Check only the current actor
# at a bounded UI-time interval; ordinary collection never scans the world here.
widget = { name = mwp_live_inventory_worker size = { 1 1 }
 state = { name = mwp_live_inventory_poll trigger_on_create = yes alpha = 1 duration = 0.25
  on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetPlayer.IsValid,GetScriptedGui('mwp_native_live_verify_inventory').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_candidate_owner',GetPlayer.MakeScope).AddScope('mwp_candidate_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_live_actor',GetPlayer.MakeScope.Var('mwp_live_character').GetCharacter.MakeScope).AddScope('mwp_live_epoch',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_live_epoch').GetValueWithDefault('(CFixedPoint)-1'))).End)),'mwp_live_inventory_commit','mwp_live_inventory_idle'))]" }
 state = { name = mwp_live_inventory_commit alpha = 1
  on_start = "[PdxGuiWidget.TriggerAnimation('mwp_live_inventory_idle')]"
  on_start = "[GetScriptedGui('mwp_native_live_verify_inventory').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_candidate_owner',GetPlayer.MakeScope).AddScope('mwp_candidate_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_live_actor',GetPlayer.MakeScope.Var('mwp_live_character').GetCharacter.MakeScope).AddScope('mwp_live_epoch',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_live_epoch').GetValueWithDefault('(CFixedPoint)-1'))).End)]" }
 state = { name = mwp_live_inventory_idle alpha = 1 duration = 0 next = mwp_live_inventory_poll }
}
}
