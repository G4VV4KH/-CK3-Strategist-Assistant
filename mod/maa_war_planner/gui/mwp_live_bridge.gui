 on_start = "[PdxGuiWidget.TriggerAnimation('mwp_live_character_observe_poll')]" }
}
widget = { name = mwp_live_actor_finish_worker size = { 1 1 }
state = { name = mwp_live_actor_finish_poll trigger_on_create = yes alpha = 1 duration = 0.01
 on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(And(GetPlayer.IsValid,And(GetPlayer.MakeScope.GetVariable('mwp_scoring_active').IsSet,And(ObjectsEqual(GetPlayer,GetPlayer.MakeScope.GetVariable('mwp_scoring_owner').GetCharacter),EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_scoring_generation').GetValueWithDefault('(CFixedPoint)-2'),GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-1'))))),And(GetPlayer.MakeScope.GetVariable('mwp_live_collecting').IsSet,EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_live_stage').GetValueWithDefault('(CFixedPoint)0'),'(CFixedPoint)1'))),And(GetPlayer.MakeScope.GetVariable('mwp_live_character_seen').IsSet,EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('mwp_live_received_count').GetValue,GetPlayer.MakeScope.Var('mwp_live_expected').GetValue))),'mwp_live_actor_finish_do','mwp_live_actor_finish_idle'))]" }
