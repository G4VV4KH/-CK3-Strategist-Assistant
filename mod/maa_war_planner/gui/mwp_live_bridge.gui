# GENERATED MWP LIVE BRIDGE; source: tests/maa_war_planner/build_live_bridge.py
window = {
    name = mwp_live_bridge
    size = { 1 1 }
    alwaystransparent = yes
    visible = "[GetPlayer.IsValid]"
    # Re-created on campaign entry/reload. Persisted scores need a new cycle;
    # the root-owned effect invalidates earlier delayed-event tokens.
    state = {
        name = mwp_session_create
        trigger_on_create = yes
        alpha = 1
        duration = 0
        on_finish = "[GetVariableSystem.Clear('mwp_bootstrapped_player')]"
    }
    widget = { name = mwp_bootstrap_worker size = { 1 1 }
    state = { name = mwp_bootstrap_local_player_wait alpha = 1 duration = 0.02
        trigger_when = "[And(GetPlayer.IsValid,And(GetScriptedGui('mwp_bootstrap').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End),Or(Not(GetVariableSystem.HasValue('mwp_bootstrapped_player',UIntToString(GetPlayer.GetID))),Not(GetPlayer.MakeScope.GetVariable('mwp_schema').IsSet))))]"
        on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetPlayer.IsValid,And(GetScriptedGui('mwp_bootstrap').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End),Or(Not(GetVariableSystem.HasValue('mwp_bootstrapped_player',UIntToString(GetPlayer.GetID))),Not(GetPlayer.MakeScope.GetVariable('mwp_schema').IsSet)))),'mwp_bootstrap_local_player_do','mwp_bootstrap_local_player_noop'))]"
    }
    state = { name = mwp_bootstrap_local_player_do alpha = 1 duration = 0
        on_finish = "[GetVariableSystem.Set('mwp_bootstrapped_player',UIntToString(GetPlayer.GetID))]"
        on_finish = "[GetScriptedGui('mwp_bootstrap').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
    state = { name = mwp_bootstrap_local_player_noop alpha = 1 }
    }
    widget = { name = mwp_begin_worker size = { 1 1 }
    state = { name = mwp_begin_poll alpha = 1 duration = 0.01
        trigger_on_create = yes
        on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetPlayer.IsValid,GetPlayer.MakeScope.GetVariable('mwp_analysis_requested').IsSet),'mwp_begin_do','mwp_begin_idle'))]"
    }
    state = { name = mwp_begin_do alpha = 1
        on_start = "[PdxGuiWidget.TriggerAnimation('mwp_begin_poll')]"
        on_start = "[GetScriptedGui('mwp_native_begin_analysis').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_candidate_owner',GetPlayer.MakeScope).AddScope('mwp_candidate_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-1'))).End)]"
        on_start = "[GetVariableSystem.Set('mwp_bridge_begin',Concatenate(UIntToString(GetPlayer.GetID),Concatenate(':',IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)-1'))))))]"
    }
    state = { name = mwp_begin_idle alpha = 1
