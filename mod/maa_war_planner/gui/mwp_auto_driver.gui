  state = { name = script_commit alpha = 1
   on_start = "[GetScriptedGui('mwp_script_driver_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_script_input_owner',GetPlayer.MakeScope).AddScope('mwp_script_input_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)0'))).AddScope('mwp_script_input_singleplayer',MakeScopeBool(Not(GameIsMultiplayer))).AddScope('mwp_input_current_balance',MakeScopeValue(GetPlayer.GetBalance)).AddScope('mwp_input_native_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_native_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_fallback_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_fallback_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_cost_max_maa',MakeScopeValue(IntToFixedPoint(GetPlayerArmyComposition.GetMaxNumberOfMAA))).AddScope('mwp_input_cost_panel_open',MakeScopeBool(IsGameViewOpen('military'))).End)]"
   duration = 0.05
   on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_auto_status').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)8'), 'script_idle', Select_CString(Or(EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_auto_status').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)13'),EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('mwp_auto_status').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)14')), 'script_quote_wait', 'script_retry')))]"
  }
  state = { name = script_idle alpha = 1 duration = 0 next = script_wait }
  state = { name = script_retry alpha = 1 duration = 2 next = script_wait }
  state = { name = script_quote_wait alpha = 1 duration = 0.05
   on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(GetPlayer.IsValid,And(Not(GameIsMultiplayer),GetScriptedGui('mwp_script_step').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_script_input_owner',GetPlayer.MakeScope).AddScope('mwp_script_input_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)0'))).AddScope('mwp_script_input_singleplayer',MakeScopeBool(Not(GameIsMultiplayer))).AddScope('mwp_input_current_balance',MakeScopeValue(GetPlayer.GetBalance)).AddScope('mwp_input_native_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_native_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_fallback_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_fallback_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_cost_max_maa',MakeScopeValue(IntToFixedPoint(GetPlayerArmyComposition.GetMaxNumberOfMAA))).AddScope('mwp_input_cost_panel_open',MakeScopeBool(IsGameViewOpen('military'))).End))), Select_CString(GetScriptedGui('mwp_script_quote_ready').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_script_input_owner',GetPlayer.MakeScope).AddScope('mwp_script_input_generation',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_generation').GetValueWithDefault('(CFixedPoint)0'))).AddScope('mwp_script_input_singleplayer',MakeScopeBool(Not(GameIsMultiplayer))).AddScope('mwp_input_current_balance',MakeScopeValue(GetPlayer.GetBalance)).AddScope('mwp_input_native_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_native_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_fallback_cost_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_fallback_cost_sequence').GetValueWithDefault('(CFixedPoint)-1'))).AddScope('mwp_input_cost_max_maa',MakeScopeValue(IntToFixedPoint(GetPlayerArmyComposition.GetMaxNumberOfMAA))).AddScope('mwp_input_cost_panel_open',MakeScopeBool(IsGameViewOpen('military'))).End), 'script_commit', 'script_quote_idle'), 'script_idle'))]"
  }
