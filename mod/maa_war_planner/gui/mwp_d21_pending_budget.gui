  on_start = "[GetScriptedGui('mwp_d21_pending_receive').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('mwp_d21p_input_owner',GetPlayer.MakeScope).AddScope('mwp_d21p_input_sequence',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_d21p_sequence').GetValueWithDefault('(CFixedPoint)-777'))).AddScope('mwp_d21p_input_clock',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_d21r_clock').GetValueWithDefault('(CFixedPoint)-777'))).AddScope('mwp_d21p_input_epoch',MakeScopeValue(GetPlayer.MakeScope.GetVariable('mwp_d21r_epoch').GetValueWithDefault('(CFixedPoint)-777'))).AddScope('mwp_d21p_input_counter',MakeScopeValue(GetPlayer.MakeScope.ScriptValue('mwp_native_cost_purchase_count_value'))).AddScope('mwp_d21p_input_prestige',MakeScopeValue(GetPlayer.GetPrestigeBalance)).AddScope('mwp_d21p_input_piety',MakeScopeValue(GetPlayer.GetPietyBalance)).AddScope('mwp_d21p_input_barter',MakeScopeValue(AccessTopBar.GetBarterGoodsBalance)).End)]"
